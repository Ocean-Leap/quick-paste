# quick-paste environment — copy to .env and fill in real values.
# Placeholders only in this file; NEVER commit real secrets. See SPEC §11.
# docker-compose reads this file automatically when named .env.

# Public URL & ingress
# Must match the Google OAuth redirect URI origin (<QP_PUBLIC_URL>/api/auth/callback).
QP_PUBLIC_URL=http://localhost:8080
# Host port the Caddy proxy is published on (the server itself is not exposed).
QP_HTTP_PORT=8080
# Cloudflare Tunnel token for the optional "tunnel" compose profile:
#   COMPOSE_PROFILES=tunnel docker compose up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Skip building the server locally by pulling a prebuilt image instead. Leave
# blank to build from source (docker compose up --build). To pull, set e.g.:
#   QP_SERVER_IMAGE=ghcr.io/vaibhavk81-git/quick-paste-server:latest
QP_SERVER_IMAGE=

# Database — PostgreSQL with pgvector (compose wires QP_DB_URL itself;
# QP_DB_URL is only needed for running the server outside docker-compose,
# e.g. ./gradlew run)
QP_DB_URL=jdbc:postgresql://localhost:5432/quickpaste
QP_DB_USER=quickpaste
QP_DB_PASS=change-me

# Blob storage (inside the container this is /data/blobs; only override for bare-JAR runs)
QP_STORAGE_DIR=/var/lib/quickpaste/blobs

# Auth mode: "google" (multi-user, needs a public FQDN) or "local"
# (single-owner password — for home-WiFi use without a domain, see README)
QP_AUTH_MODE=google
QP_LOCAL_PASSWORD=

# HTTPS port for LAN use (Caddy internal CA; trust it on your devices for
# full PWA features — see README). Grab the root CA from /qp-ca.crt.
QP_HTTPS_PORT=8443
# Bounce plain-HTTP LAN hits to HTTPS once you've trusted the CA (localhost and
# the Cloudflare tunnel are always exempt). Leave false for a frictionless
# HTTP trial; set true to enforce HTTPS on the LAN.
QP_LAN_HTTPS_ONLY=false

# Google OIDC (Google Cloud Console → Credentials → OAuth client ID → Web application;
# authorized redirect URI: <QP_PUBLIC_URL>/api/auth/callback)
QP_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
QP_GOOGLE_CLIENT_SECRET=change-me

# Access gate & sessions (first allowlisted email to sign in becomes admin, FR-3)
QP_ALLOWED_EMAILS=you@example.com
# Generate with: openssl rand -base64 32
QP_SESSION_SECRET=generate-a-long-random-string
QP_SESSION_TTL_HOURS=720
QP_TOKEN_TTL_DAYS=0

# TTLs, sweep & GC
QP_CLIP_TTL_HOURS=24
QP_FILE_TTL_HOURS=72
QP_SWEEP_INTERVAL_MIN=15
QP_UPLOAD_IDLE_GC_HOURS=24
QP_EXPORT_TTL_HOURS=24

# Size caps & quotas
QP_MAX_TEXT_KB=256
QP_SIMPLE_UPLOAD_MB=20
QP_MAX_FILE_MB=512
QP_USER_QUOTA_MB=2048

# Dedup, membership & connection limits
QP_DEDUP_WINDOW_SEC=10
QP_IDEMPOTENCY_TTL_SEC=3600
QP_CHANNEL_MAX_MEMBERS=25
QP_MAX_WS_CONN_PER_USER=10
QP_RATE_LIMIT_PER_MIN=600
QP_LOGIN_RATE_LIMIT_PER_MIN=10
# Trusted reverse proxies in front of the origin (login rate limit keys on the
# client IP this many hops from the right of X-Forwarded-For). 1 = Caddy only
# (compose default), 2 = Cloudflare in front of Caddy, 0 = none/bare JAR.
QP_TRUSTED_PROXY_COUNT=1

# Web push (optional; push stays disabled while unset)
# Generate a key pair with: npx web-push generate-vapid-keys
QP_VAPID_PUBLIC_KEY=
QP_VAPID_PRIVATE_KEY=
QP_VAPID_SUBJECT=mailto:you@example.com

# Thumbnails
QP_THUMBNAILS_ENABLED=true
QP_THUMBNAIL_MAX_PX=320

# External sink delivery worker (SPEC §5.14; see docs/external-providers.md)
QP_SINK_DELIVERY_INTERVAL_SEC=15
QP_SINK_MAX_ATTEMPTS=8

# Local dev ONLY — maps every request to a fixed dev user; never enable in a
# deployed config.
QP_DEV_AUTH_BYPASS=false
QP_DEV_USER_EMAIL=dev@localhost
